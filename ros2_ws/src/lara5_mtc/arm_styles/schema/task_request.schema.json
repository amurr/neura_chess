{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superbloom.local/lara5_mtc/arm_styles/task_request.schema.json",
  "title": "Lara5 MTC chess task request",
  "description": "High-level inputs for building or parameterizing an MTC pick-place task. Joint radians are output-only (see solution preview JSON).",
  "type": "object",
  "additionalProperties": false,
  "required": ["move"],
  "properties": {
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-h][1-8]$",
          "description": "Chess square of piece to pick"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-h][1-8]$",
          "description": "Chess square to place"
        }
      }
    },
    "arm_style": {
      "type": "string",
      "description": "Catalog style id or semantic alias from selection_rules.yaml",
      "default": "pre_pick_over_board",
      "examples": ["pre_pick_over_board", "mid_move_transit", "stand_home", "seed", "home"]
    },
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["top_down", "explicit_rpy", "from_seed_fk"],
          "default": "from_seed_fk",
          "description": "from_seed_fk uses FK of arm_style; top_down uses chess_top_down_* params"
        },
        "hover_z_m": { "type": "number" },
        "approach_m": { "type": "number", "default": 0.08 },
        "lift_m": { "type": "number", "default": 0.08 },
        "place_descent_m": { "type": "number", "default": 0.04 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_planning_failure": {
          "type": "boolean",
          "default": true,
          "description": "If true, try styles in selection_rules.retry_sequence"
        }
      }
    },
    "mtc_tree": {
      "type": "string",
      "const": "chess_cylinders_pick_place",
      "description": "Fixed MTC template id; LLM parametrizes, does not invent arbitrary stage graphs yet"
    }
  }
}
