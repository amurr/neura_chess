<?xml version="1.0" encoding="UTF-8"?>
<!-- Localhost-only DDS (WSL / Docker).
     Do NOT list <Interfaces>/<NetworkInterface name="lo"/> here: ROS_LOCALHOST_ONLY=1
     already binds loopback, and listing lo again fails with
     "the same interface may not be selected twice".
     ParticipantIndex none avoids index exhaustion when many nodes start. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
