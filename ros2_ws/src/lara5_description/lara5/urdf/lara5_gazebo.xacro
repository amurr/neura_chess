<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- Gazebo / gz-sim tags for LeRobot gripper fingers (included from lara5_gz.urdf.xacro). -->
  <xacro:macro name="lara5_gazebo_tags" params="prefix:=lara5_">
    <gazebo reference="${prefix}gripper_jaw">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1e5</kp>
      <kd>1</kd>
    </gazebo>
    <gazebo reference="${prefix}gripper_body">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${prefix}gripper">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
  </xacro:macro>
</robot>
