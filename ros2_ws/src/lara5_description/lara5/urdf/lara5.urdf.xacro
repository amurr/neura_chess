<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro"
       name="lara5" >

  <xacro:arg name="prefix" default="lara5_"/>
  <!-- so101_follower_description meshes are already in metres: use scale "1 1 1" -->
  <xacro:arg name="so101_mesh_uri" default="package://lara5_description/lara5/meshes/so101"/>
  <xacro:arg name="so101_mesh_scale" default="0.001 0.001 0.001"/>
  <xacro:arg name="parameter_file_name" default="lara5_kinematic_parameters_nominal"/>
  <xacro:arg name="dynamic_parameter_file_name" default="lara5_dynamic_parameters_nominal"/>
  <xacro:arg name="limits_file_name" default="lara5_limits"/>


  <xacro:include filename="lara5_macro.xacro" />
  
  <xacro:lara5_robot prefix="$(arg prefix)"
                    parameter_file_name = "$(arg parameter_file_name)"
                    dynamic_parameter_file_name =  "$(arg dynamic_parameter_file_name)"
                    limits_file_name = "$(arg limits_file_name)"
                    so101_mesh_uri = "$(arg so101_mesh_uri)"
                    so101_mesh_scale = "$(arg so101_mesh_scale)" />

  <link name="world" />
  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link = "$(arg prefix)root_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

</robot>
