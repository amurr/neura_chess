      Enabled: true
      Name: ChessBoard
      Namespaces:
        chess_board: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /chess_board_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ChessPieces
      Namespaces:
        chess_pieces: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /chess_piece_markers
