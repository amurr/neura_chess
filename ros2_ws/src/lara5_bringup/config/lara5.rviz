Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /MotionPlanning1
        - /ChessBoard1
        - /ChessPieces1
      Splitter Ratio: 0.5
    Tree Height: 70
Visualization Manager:
  Class: ""
  Displays:
